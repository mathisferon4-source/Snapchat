import React, { useEffect, useState } from "react";
import { createRoot } from "react-dom/client";
import {
  Search, Shield, Activity, Globe, Users,
  FileText, Trash2, Download, ExternalLink,
  Clock, AlertTriangle, LoaderCircle
} from "lucide-react";
import "./style.css";

const API = "http://127.0.0.1:8000";

function App() {
  const [username, setUsername] = useState("");
  const [mode, setMode] = useState("quick");
  const [loading, setLoading] = useState(false);
  const [results, setResults] = useState(null);
  const [history, setHistory] = useState([]);
  const [error, setError] = useState("");
  const [maxResults, setMaxResults] = useState(10);

  const [modules, setModules] = useState({
    username_search: true,
    public_profile: true,
    social_search: true,
    web_footprint: true
  });

  async function loadHistory() {
    try {
      const response = await fetch(`${API}/api/history`);
      if (response.ok) setHistory(await response.json());
    } catch {
      setHistory([]);
    }
  }

  useEffect(() => {
    loadHistory();
  }, []);

  function toggle(name) {
    setModules(old => ({ ...old, [name]: !old[name] }));
  }

  async function analyze() {
    if (username.trim().length < 2) {
      setError("Entre un pseudo valide.");
      return;
    }

    setLoading(true);
    setError("");
    setResults(null);

    try {
      const response = await fetch(`${API}/api/analyze`, {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({
          username,
          mode,
          max_results: Number(maxResults),
          modules: Object.keys(modules).filter(key => modules[key])
        })
      });

      const data = await response.json();
      if (!response.ok) throw new Error(data.detail || "Erreur de recherche.");

      setResults(data);
      loadHistory();
    } catch (e) {
      setError(e.message || "Impossible de contacter le serveur.");
    } finally {
      setLoading(false);
    }
  }

  async function clearHistory() {
    if (!confirm("Supprimer tout l'historique ?")) return;
    await fetch(`${API}/api/history`, { method: "DELETE" });
    setHistory([]);
  }

  function exportFile(type) {
    if (results?.id) {
      window.open(`${API}/api/reports/${results.id}/${type}`, "_blank");
    }
  }

  async function openHistory(id) {
    const response = await fetch(`${API}/api/reports/${id}`);
    if (response.ok) setResults(await response.json());
  }

  return (
    <div className="app">
      <aside className="sidebar">
        <div className="brand">
          <div className="brand-icon"><Shield /></div>
          <div>
            <h2>SNAP<span>INTELLIGENCE</span></h2>
            <small>PUBLIC SEARCH PLATFORM</small>
          </div>
        </div>

        <div className="menu-label">NAVIGATION</div>
        <a className="active"><Activity size={18}/> Dashboard</a>
        <a href="#search"><Search size={18}/> Recherche</a>
        <a href="#history"><Clock size={18}/> Historique</a>

        <div className="sidebar-bottom">
          <div className="secure">
            <Shield size={19}/>
            <div>
              <strong>Recherche publique</strong>
              <small>Aucun accès privé</small>
            </div>
          </div>
        </div>
      </aside>

      <main className="main">
        <header className="topbar">
          <div>
            <div className="eyebrow">CENTRE DE RECHERCHE</div>
            <h1>Dashboard</h1>
          </div>
          <div className="status"><span/> SYSTEM ONLINE</div>
        </header>

        <section className="welcome">
          <div>
            <div className="eyebrow">SNAP INTELLIGENCE / 01</div>
            <h2>Explore les traces <span>publiques.</span></h2>
            <p>Recherche des occurrences de pseudonymes sur les sources accessibles publiquement.</p>
          </div>
          <div className="welcome-icon"><Globe size={55}/></div>
        </section>

        <section className="stats">
          <div className="stat-card">
            <div className="stat-icon purple"><Search/></div>
            <div><small>RECHERCHES ENREGISTRÉES</small><h2>{history.length}</h2></div>
          </div>
          <div className="stat-card">
            <div className="stat-icon blue"><Shield/></div>
            <div><small>MODE DE RECHERCHE</small><h2>PUBLIC</h2></div>
          </div>
          <div className="stat-card">
            <div className="stat-icon green"><Activity/></div>
            <div><small>ÉTAT DU SYSTÈME</small><h2>EN LIGNE</h2></div>
          </div>
        </section>

        <section className="panel" id="search">
          <div className="panel-heading">
            <div>
              <div className="eyebrow">MODULE PRINCIPAL</div>
              <h2><Search size={21}/> Recherche de pseudo</h2>
            </div>
            <span className="tag">PUBLIC DATA ONLY</span>
          </div>

          <label>PSEUDO À RECHERCHER</label>
          <div className="searchbar">
            <Search/>
            <input
              value={username}
              onChange={e => setUsername(e.target.value)}
              onKeyDown={e => e.key === "Enter" && analyze()}
              placeholder="Entre un pseudo..."
            />
            <button onClick={analyze} disabled={loading}>
              {loading ? <LoaderCircle className="spin"/> : <Search size={17}/>}
              {loading ? "RECHERCHE..." : "LANCER L'ANALYSE"}
            </button>
          </div>

          <div className="settings-grid">
            <div>
              <label>PROFONDEUR</label>
              <select value={mode} onChange={e => setMode(e.target.value)}>
                <option value="quick">Recherche rapide</option>
                <option value="deep">Recherche approfondie</option>
              </select>
            </div>
            <div>
              <label>NOMBRE MAXIMUM DE RÉSULTATS</label>
              <select value={maxResults} onChange={e => setMaxResults(e.target.value)}>
                <option value="5">5 résultats</option>
                <option value="10">10 résultats</option>
                <option value="20">20 résultats</option>
              </select>
            </div>
          </div>

          <label>MODULES À ACTIVER</label>
          <div className="modules">
            <label className="module">
              <input type="checkbox" checked={modules.username_search} onChange={() => toggle("username_search")}/>
              <Search/><span>USERNAME SEARCH</span>
            </label>
            <label className="module">
              <input type="checkbox" checked={modules.public_profile} onChange={() => toggle("public_profile")}/>
              <Users/><span>PUBLIC PROFILE</span>
            </label>
            <label className="module">
              <input type="checkbox" checked={modules.social_search} onChange={() => toggle("social_search")}/>
              <Globe/><span>SOCIAL SEARCH</span>
            </label>
            <label className="module">
              <input type="checkbox" checked={modules.web_footprint} onChange={() => toggle("web_footprint")}/>
              <FileText/><span>WEB FOOTPRINT</span>
            </label>
          </div>

          {error && <div className="error">{error}</div>}
        </section>

        {results && (
          <section className="panel">
            <div className="panel-heading">
              <div>
                <div className="eyebrow">RAPPORT D'ANALYSE</div>
                <h2>Résultats : {results.username}</h2>
              </div>
              <div className="export-buttons">
                <button className="secondary" onClick={() => exportFile("json")}><Download size={15}/> JSON</button>
                <button className="secondary" onClick={() => exportFile("pdf")}><Download size={15}/> PDF</button>
              </div>
            </div>

            <div className="notice">
              <AlertTriangle size={18}/>
              {results.notice}
            </div>

            <p className="result-count">{results.result_count} résultat(s) trouvé(s)</p>

            {results.results.length === 0 && (
              <p className="empty">Aucun résultat public disponible.</p>
            )}

            {results.results.map((item, index) => (
              <div className="result" key={item.url || index}>
                <div className="result-top">
                  <strong>{item.title}</strong>
                  <span className="possible">Correspondance possible</span>
                </div>
                <p>{item.description}</p>
                <a href={item.url} target="_blank" rel="noreferrer">
                  Consulter la source <ExternalLink size={14}/>
                </a>
              </div>
            ))}
          </section>
        )}

        <section className="panel" id="history">
          <div className="panel-heading">
            <div>
              <div className="eyebrow">ACTIVITÉ</div>
              <h2><Clock size={20}/> Historique</h2>
            </div>
            <button className="secondary danger" onClick={clearHistory}>
              <Trash2 size={15}/> Effacer
            </button>
          </div>

          {history.length === 0 && <p className="empty">Aucune recherche enregistrée.</p>}

          {history.map(item => (
            <button className="history-item" key={item.id} onClick={() => openHistory(item.id)}>
              <Search size={17}/>
              <span>{item.username}</span>
              <small>{new Date(item.created_at).toLocaleString("fr-FR")}</small>
            </button>
          ))}
        </section>

        <footer>
          SNAP INTELLIGENCE — Recherche limitée aux informations publiques.
          Respecte la vie privée et les conditions des sites consultés.
        </footer>
      </main>
    </div>
  );
}

createRoot(document.getElementById("root")).render(<App/>);
