  border: 1px solid #61452a; border-radius: 9px; font-size: 12px;
}
.result-count, .empty { color: #9d94ad; font-size: 12px; }
.result { padding: 17px 0; border-bottom: 1px solid #302840; }
.result-top { display: flex; justify-content: space-between; gap: 10px; }
.result strong { font-size: 13px; }
.result p { color: #a9a0b9; font-size: 12px; }
.result a {
  color: #ae8aff; font-size: 11px; text-decoration: none;
  display: inline-flex; align-items: center; gap: 5px;
}
.possible { color: #edc47b; font-size: 9px; }
.secondary { background: #28213a; color: #c8b5ef; }
.danger { color: #ff9b9b; }
.export-buttons { display: flex; gap: 8px; }
.history-item {
  display: flex; width: 100%; justify-content: flex-start;
  background: #1a1527; border: 1px solid #302640;
  margin: 8px 0; text-align: left;
}
.history-item span { flex: 1; }
.history-item small { color: #9b91aa; }
footer { color: #716981; text-align: center; font-size: 10px; padding: 30px 0; }
.spin { animation: spin 1s linear infinite; }
@keyframes spin { to { transform: rotate(360deg); } }
@media(max-width:900px) {
  .sidebar { width: 75px; padding: 20px 10px; }
  .brand { justify-content: center; }
  .brand > div:last-child, .menu-label, .sidebar a:not(.active), .sidebar a.active { font-size: 0; }
  .brand h2, .brand small, .secure div { display: none; }
  .sidebar a { justify-content: center; }
  .main { margin-left: 75px; padding: 25px 3%; }
  .stats { grid-template-columns: 1fr; }
  .modules { grid-template-columns: 1fr 1fr; }
}
@media(max-width:550px) {
  .welcome { padding: 22px; }
  .welcome h2 { font-size: 21px; }
  .welcome-icon { display: none; }
  .settings-grid { grid-template-columns: 1fr; }
  .searchbar { flex-wrap: wrap; }
  .searchbar button { width: 100%; }
  .panel { padding: 17px; }
  .panel-heading { align-items: flex-start; flex-direction: column; }
  .status { display: none; }
  .result-top { flex-direction: column; }
}
