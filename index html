import os
import sqlite3
import json
from datetime import datetime, timezone
from io import BytesIO

import httpx
from fastapi import FastAPI, HTTPException
from fastapi.middleware.cors import CORSMiddleware
from fastapi.responses import StreamingResponse
from pydantic import BaseModel, Field
from reportlab.pdfgen import canvas
from reportlab.lib.pagesizes import A4

app = FastAPI(title="SNAP INTELLIGENCE API")

app.add_middleware(
    CORSMiddleware,
    allow_origins=["http://localhost:5173"],
    allow_methods=["GET", "POST", "DELETE"],
    allow_headers=["*"]
)

DB = os.path.join(os.path.dirname(__file__), "snap_intelligence.db")

def connect():
    db = sqlite3.connect(DB)
    db.row_factory = sqlite3.Row
    return db

def initialize():
    db = connect()
    db.execute("""
        CREATE TABLE IF NOT EXISTS reports (
            id INTEGER PRIMARY KEY AUTOINCREMENT,
            username TEXT NOT NULL,
            created_at TEXT NOT NULL,
            result TEXT NOT NULL
        )
    """)
    db.commit()
    db.close()

initialize()

class SearchRequest(BaseModel):
    username: str = Field(min_length=2, max_length=50)
    mode: str = "quick"
    max_results: int = Field(default=10, ge=1, le=20)
    modules: list[str] = [
        "username_search",
        "social_search",
        "web_footprint"
    ]

async def public_search(query, maximum):
    key = os.getenv("BRAVE_API_KEY")
    if not key:
        return {
            "available": False,
            "message": "Clé BRAVE_API_KEY non configurée.",
            "results": []
        }

    try:
        async with httpx.AsyncClient(timeout=15) as client:
            response = await client.get(
                "https://api.search.brave.com/res/v1/web/search",
                params={"q": query, "count": maximum},
                headers={
                    "Accept": "application/json",
                    "X-Subscription-Token": key
                }
            )
            response.raise_for_status()
            data = response.json()

        results = []
        for item in data.get("web", {}).get("results", []):
            results.append({
                "title": item.get("title", "Sans titre"),
                "url": item.get("url", ""),
                "description": item.get("description", ""),
                "confidence": "Correspondance possible",
                "verified": False
            })

        return {
            "available": True,
            "message": "Résultats issus du web public.",
            "results": results
        }

    except Exception:
        return {
            "available": False,
            "message": "Recherche temporairement indisponible.",
            "results": []
        }

@app.get("/")
def home():
    return {"name": "SNAP INTELLIGENCE", "status": "online"}

@app.get("/api/status")
def status():
    return {"status": "online"}

@app.post("/api/analyze")
async def analyze(request: SearchRequest):
    username = request.username.strip().lstrip("@")

    if not username or any(c.isspace() for c in username):
        raise HTTPException(400, "Pseudo invalide.")

    modules = {}
    results = []

    if "username_search" in request.modules:
        modules["username_search"] = await public_search(
            f'"{username}"',
            request.max_results
        )

    if "social_search" in request.modules:
        modules["social_search"] = await public_search(
            f'"{username}" site:instagram.com OR site:tiktok.com OR site:x.com',
            request.max_results
        )

    if "web_footprint" in request.modules:
        modules["web_footprint"] = await public_search(
            f'"{username}"',
            request.max_results
        )

    if "public_profile" in request.modules:
        modules["public_profile"] = {
            "available": False,
            "message": "Aucun accès direct aux profils Snapchat. Seules les pages publiques indexées peuvent être recherchées."
        }

    for module in modules.values():
        results.extend(module.get("results", []))

    unique = {}
    for item in results:
        if item.get("url"):
            unique[item["url"]] = item

    results = list(unique.values())[:request.max_results]

    report = {
        "username": username,
        "created_at": datetime.now(timezone.utc).isoformat(),
        "mode": request.mode,
        "modules": modules,
        "results": results,
        "result_count": len(results),
        "notice": "Une correspondance de pseudo ne prouve pas l'identité d'une personne."
    }

    db = connect()
    cursor = db.execute(
        "INSERT INTO reports(username, created_at, result) VALUES (?, ?, ?)",
        (
            username,
            report["created_at"],
            json.dumps(report, ensure_ascii=False)
        )
    )
    report["id"] = cursor.lastrowid
    db.commit()
    db.close()

    return report

@app.get("/api/history")
def history():
    db = connect()
    rows = db.execute(
        "SELECT id, username, created_at FROM reports ORDER BY id DESC LIMIT 50"
    ).fetchall()
    db.close()
    return [dict(row) for row in rows]

@app.delete("/api/history")
def clear_history():
    db = connect()
    db.execute("DELETE FROM reports")
    db.commit()
    db.close()
    return {"message": "Historique supprimé."}

@app.get("/api/reports/{report_id}")
def get_report(report_id: int):
    db = connect()
    row = db.execute(
        "SELECT result FROM reports WHERE id = ?",
        (report_id,)
    ).fetchone()
    db.close()

    if not row:
        raise HTTPException(404, "Rapport introuvable.")

    return json.loads(row["result"])

@app.get("/api/reports/{report_id}/json")
def export_json(report_id: int):
    report = get_report(report_id)
    content = json.dumps(report, ensure_ascii=False, indent=2)

    return StreamingResponse(
        BytesIO(content.encode("utf-8")),
        media_type="application/json",
        headers={
            "Content-Disposition": f"attachment; filename=rapport-{report_id}.json"
        }
    )

@app.get("/api/reports/{report_id}/pdf")
def export_pdf(report_id: int):
    report = get_report(report_id)
    buffer = BytesIO()
    pdf = canvas.Canvas(buffer, pagesize=A4)
    width, height = A4
    y = height - 50

    pdf.setFont("Helvetica-Bold", 18)
    pdf.drawString(45, y, "SNAP INTELLIGENCE")
    y -= 35

    pdf.setFont("Helvetica", 10)
    lines = [
        "Rapport de recherche publique",
        f"Pseudo : {report['username']}",
        f"Date : {report['created_at']}",
        f"Resultats : {report['result_count']}",
        "",
        "Une correspondance de pseudo ne prouve pas une identite.",
        "",
        "RESULTATS"
    ]

    for line in lines:
        pdf.drawString(45, y, line)
        y -= 17

    for item in report["results"]:
        if y < 80:
            pdf.showPage()
            y = height - 50
            pdf.setFont("Helvetica", 10)

        for line in [
            item.get("title", "")[:90],
            item.get("url", "")[:100],
            item.get("description", "")[:120],
            ""
        ]:
            pdf.drawString(45, y, line)
            y -= 15

    pdf.save()
    buffer.seek(0)

    return StreamingResponse(
        buffer,
        media_type="application/pdf",
        headers={
            "Content-Disposition": f"attachment; filename=rapport-{report_id}.pdf"
        }
    )
